# The in-path floor, not a competitor. Serves all six workloads by construction: it
# relays bytes and never looks at them, so the dialect is irrelevant.
#
# Read its row as the zero line. A gateway's honest overhead in this harness is its
# added figure minus this one. Caveat for the capacity sweep only: socat forks a
# process per connection, so its throughput collapses at high concurrency and its
# capacity column means nothing. The latency column is the one to use.
IMAGE=alpine/socat:latest
PORT=8080
MODEL=gpt-4o-mini
HEADERS=()
