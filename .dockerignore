# The context root is the repository root, because both the release Dockerfile and
# bench/enterpilot/Dockerfile build the whole tree. The classic builder reads this file and only this one: a
# Dockerfile.dockerignore beside the Dockerfile is a BuildKit feature and buildx is
# not always installed.
